{
  "description": "Network inventory from official Integration API (networks, WiFi, WAN, VPN, firewall, switching). WAN byte counters are NOT available.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "title": "Inventory counts by kind",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (kind) (unifi_inventory{job=~\"$job\",instance=~\"$instance\"})",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "title": "Inventory entities",
      "type": "table",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "unifi_inventory_info{job=~\"$job\",instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "id": 2
    }
  ],
  "schemaVersion": 39,
  "tags": ["unifi", "unifi-exporter"],
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus" },
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(unifi_exporter_up, job)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(unifi_exporter_up{job=~\"$job\"}, instance)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "UniFi Exporter / Network Inventory",
  "uid": "unifi-exporter-network",
  "version": 1
}
