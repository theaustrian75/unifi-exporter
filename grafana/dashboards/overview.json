{
  "description": "UniFi exporter overview (hybrid Integration + classic APIs). Metric names match unpoller.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "title": "Exporter up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "max(unifi_exporter_up{job=~\"$job\",instance=~\"$instance\"})", "refId": "A" }],
      "id": 1
    },
    {
      "title": "Integration / classic",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "max(unifi_exporter_integration_up{job=~\"$job\",instance=~\"$instance\"})", "legendFormat": "integration", "refId": "A" },
        { "expr": "max(unifi_exporter_classic_up{job=~\"$job\",instance=~\"$instance\"})", "legendFormat": "classic", "refId": "B" }
      ],
      "id": 2
    },
    {
      "title": "Cache age",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "expr": "max(unifi_exporter_cache_age_seconds{job=~\"$job\",instance=~\"$instance\"})", "refId": "A" }],
      "id": 3
    },
    {
      "title": "Sites",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "max(unifi_sites{job=~\"$job\",instance=~\"$instance\"})", "refId": "A" }],
      "id": 4
    },
    {
      "title": "Devices",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "max(unifi_devices{job=~\"$job\",instance=~\"$instance\"})", "refId": "A" }],
      "id": 5
    },
    {
      "title": "Clients",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "max(unifi_clients{job=~\"$job\",instance=~\"$instance\"})", "refId": "A" }],
      "id": 6
    },
    {
      "title": "CPU utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "expr": "unifi_device_cpu_utilization_ratio{job=~\"$job\",instance=~\"$instance\"}", "legendFormat": "{{name}}", "refId": "A" }],
      "id": 8
    },
    {
      "title": "WAN receive rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [{ "expr": "unifi_device_wan_receive_rate_bytes{job=~\"$job\",instance=~\"$instance\"}", "legendFormat": "{{name}}", "refId": "A" }],
      "id": 9
    }
  ],
  "schemaVersion": 39,
  "tags": ["unifi", "unifi-exporter", "unpoller"],
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus" },
      { "name": "job", "type": "query", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "query": "label_values(unifi_exporter_up, job)", "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" }, "refresh": 2 },
      { "name": "instance", "type": "query", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "query": "label_values(unifi_exporter_up{job=~\"$job\"}, instance)", "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" }, "refresh": 2 }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "UniFi Exporter / Overview",
  "uid": "unifi-exporter-overview",
  "version": 2
}
