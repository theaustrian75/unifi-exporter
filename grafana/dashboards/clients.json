{
  "description": "Connected clients from classic /stat/sta (unpoller-compatible). Requires classic username/password.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "title": "Total clients",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "max(unifi_clients{job=~\"$job\",instance=~\"$instance\"})", "refId": "A" }],
      "id": 1
    },
    {
      "title": "RSSI",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "dB" }, "overrides": [] },
      "targets": [{ "expr": "unifi_client_rssi_db{job=~\"$job\",instance=~\"$instance\"}", "legendFormat": "{{name}}", "refId": "A" }],
      "id": 2
    },
    {
      "title": "Signal",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "dB" }, "overrides": [] },
      "targets": [{ "expr": "unifi_client_radio_signal_db{job=~\"$job\",instance=~\"$instance\"}", "legendFormat": "{{name}}", "refId": "A" }],
      "id": 3
    },
    {
      "title": "Receive bytes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [{ "expr": "rate(unifi_client_receive_bytes_total{job=~\"$job\",instance=~\"$instance\"}[5m])", "legendFormat": "{{name}}", "refId": "A" }],
      "id": 4
    },
    {
      "title": "Transmit bytes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [{ "expr": "rate(unifi_client_transmit_bytes_total{job=~\"$job\",instance=~\"$instance\"}[5m])", "legendFormat": "{{name}}", "refId": "A" }],
      "id": 5
    }
  ],
  "schemaVersion": 39,
  "tags": ["unifi", "unifi-exporter", "unpoller"],
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus" },
      { "name": "job", "type": "query", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "query": "label_values(unifi_exporter_up, job)", "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" }, "refresh": 2 },
      { "name": "instance", "type": "query", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "query": "label_values(unifi_exporter_up{job=~\"$job\"}, instance)", "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" }, "refresh": 2 }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "UniFi Exporter / Clients",
  "uid": "unifi-exporter-clients",
  "version": 2
}
